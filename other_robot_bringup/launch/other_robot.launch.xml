
<launch>
	<let name="urdf_path" value="$(find-pkg-share other_robot_description)/urdf/other_robot.urdf.xacro" />
	<let name="gazebo_config_path" value="$(find-pkg-share other_robot_bringup)/config/gazebo_bridge.yaml" />
	<let name="nav2_params_path" value="$(find-pkg-share other_robot_bringup)/config/nav2_params.yaml" />
	<let name="controller_path" value="$(find-pkg-share other_robot_bringup)/config/controller.yaml" />
	<let name="rviz_config_path" value="$(find-pkg-share other_robot_description)/rviz/urdf_config.rviz" />
	<let name="world_path" value="$(find-pkg-share other_robot_bringup)/world/hospital.sdf" />


	<set_env
    	name="GZ_SIM_RESOURCE_PATH"
    	value="$(find-pkg-prefix other_robot_description)/share" />



	<node pkg="robot_state_publisher" exec="robot_state_publisher">
    		<param name="robot_description"
			value="$(command 'xacro $(var urdf_path)')" />	
			<param name="use_sim_time"
        	value="true"/>	
	</node>

	<include
    		file="$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py">
    		<arg name="gz_args" value="$(var world_path) -r" />
	</include>
	

	<node 	pkg="ros_gz_sim" exec="create" 	
    	  	output="screen"
		  	args="-topic robot_description -name rosbot -allow_renaming true -z 0.2 -x -6.0 -y 0.0 -Y 0.0" >

	</node>


	<node pkg="ros_gz_bridge" exec="parameter_bridge">
    		<param name="config_file"
			value="$(var gazebo_config_path)" />
		<param name="use_sim_time"
        	value="true"/>	
	</node>


	<node pkg="controller_manager" exec="spawner" args="joint_state_broadcaster --param-file $(var controller_path)">
	</node>

	<node pkg="controller_manager" exec="spawner" args="diff_drive_controller --param-file $(var controller_path)">
	</node>



	<node pkg="rviz2" exec="rviz2" args="-d $(find-pkg-share nav2_bringup)/rviz/nav2_default_view.rviz">
		<param name="use_sim_time"	value="true"/>	

	</node>

	<include
    		file="$(find-pkg-share nav2_bringup)/launch/bringup_launch.py">
    		<arg name="use_sim_time" value="true"/>

    <arg name="autostart" value="true"/>

    <arg name="map"
         value="$(find-pkg-share other_robot_bringup)/maps/hospital.yaml"/>

    <arg name="params_file"
         value="$(var nav2_params_path)"/>

    <arg name="package_path"
         value="$(find-pkg-share other_robot_bringup)"/>

	</include>


	<node
    pkg="tf2_ros"
    exec="static_transform_publisher"
    name="map_to_odom"
    output="screen"
    args="0 0 0 0 0 0 map odom"/>


</launch>
